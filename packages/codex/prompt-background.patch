 // Decorative table rules should remain visible without competing with cell content.
 const TABLE_SEPARATOR_FG_ALPHA: f32 = 0.20;
 
+pub(crate) fn composer_style() -> Style {
+    match default_bg() {
+        Some(bg) => Style::default().bg(best_color(composer_bg_rgb(bg))),
+        None => Style::default(),
+    }
+}
+
+pub(crate) fn composer_bg_rgb(terminal_bg: (u8, u8, u8)) -> (u8, u8, u8) {
+    if is_light(terminal_bg) {
+        user_message_bg_rgb(terminal_bg)
+    } else {
+        (0x20, 0x21, 0x22)
+    }
+}
+
 pub fn user_message_style() -> Style {
     user_message_style_for(default_bg())
 }
