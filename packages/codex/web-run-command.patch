+async fn run_local_search(
+    command: &OsStr,
+    request: &SearchRequest,
+) -> Result<SearchResponse, String> {
+    use tokio::io::AsyncWriteExt;
+
+    let name = command.to_string_lossy();
+    let body = serde_json::to_vec(request).map_err(|err| format!("web.run request: {err}"))?;
+    let mut child = tokio::process::Command::new(command)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .kill_on_drop(true)
+        .spawn()
+        .map_err(|err| format!("{name}: {err}"))?;
+    let mut stdin = child
+        .stdin
+        .take()
+        .ok_or_else(|| format!("{name}: no stdin"))?;
+    stdin
+        .write_all(&body)
+        .await
+        .map_err(|err| format!("{name}: {err}"))?;
+    drop(stdin);
+    let output = tokio::time::timeout(WEB_RUN_COMMAND_TIMEOUT, child.wait_with_output())
+        .await
+        .map_err(|_| {
+            format!(
+                "{name}: no answer within {}s",
+                WEB_RUN_COMMAND_TIMEOUT.as_secs()
+            )
+        })?
+        .map_err(|err| format!("{name}: {err}"))?;
+    if !output.status.success() {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        let reason = stderr.trim();
+        return Err(if reason.is_empty() {
+            format!("{name}: {}", output.status)
+        } else {
+            reason.to_string()
+        });
+    }
+    serde_json::from_slice(&output.stdout).map_err(|err| format!("{name}: invalid response: {err}"))
+}
